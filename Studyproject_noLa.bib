@article{he_integrating_2026,
	title = {Integrating cytological images and spatial transcriptomics for cell segmentation with {DISSECT}},
	volume = {6},
	copyright = {2026 The Author(s), under exclusive licence to Springer Nature America, Inc.},
	issn = {2662-8457},
	url = {https://www.nature.com/articles/s43588-026-01020-x},
	doi = {10.1038/s43588-026-01020-x},
	abstract = {Advances in imaging- and sequencing-based spatial transcriptomics have increased molecular throughput and resolution, enabling the measurement and analysis of spatial transcriptomes at single-cell resolution. However, accurate cell segmentation remains challenging because cell morphology, tissue processing and staining methods vary across samples and platforms, limiting the accuracy and generalizability of existing algorithms. Here we show that DISSECT, a cell segmentation model integrating cytological images with spatial transcriptomic profiles, improves spatial single-cell transcriptome reconstruction. DISSECT uses a pretrained deep generative model to denoise multiscale image features, predicts cell instances with an instance-aware detection module and applies image- and transcriptome-derived gradient fields to refine segmentation masks. Benchmarking across multiple datasets showed that DISSECT achieved higher mean average precision than several existing segmentation tools. We further applied DISSECT to three pairs of gastric adenocarcinoma samples collected before and after anti-PD-1 treatment and profiled by Stereo-seq, illustrating its utility for downstream spatial biological interpretation.},
	language = {en},
	number = {7},
	urldate = {2026-08-24},
	journal = {Nature Computational Science},
	publisher = {Nature Publishing Group},
	author = {He, Yufeng and Zhao, Yanping and Zhang, Rui and Yang, Heli and Zhang, Zongxu and Ren, Pengfei and Luo, Ce and Zhang, Peng and Zhang, Zhe and Hou, Sen and Bu, Zhaode and Luo, Yuan and Pan, Deng and Zeng, Zexian},
	month = jul,
	year = {2026},
	keywords = {Machine learning, Computational models, Data mining},
	pages = {718--731},
	file = {Full Text PDF:C\:\\Users\\juno12\\Zotero\\storage\\MD9I2V3F\\He et al. - 2026 - Integrating cytological images and spatial transcriptomics for cell segmentation with DISSECT.pdf:application/pdf},
}

